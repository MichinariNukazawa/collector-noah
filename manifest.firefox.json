{
  "manifest_version": 3,
  "name": "Collector Noah",
  "version": "0.1.3",
  "description": "Collect images you click, open, like, or save into your local Collector Noah.",
  "permissions": ["storage", "contextMenus", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://www.pixiv.net/*",
        "*://danbooru.donmai.us/*",
        "*://*.dmm.co.jp/*",
        "*://*.melonbooks.co.jp/*",
        "*://www.dlsite.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Collector Noah",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "atelier-capture@local",
      "strict_min_version": "115.0"
    }
  }
}
