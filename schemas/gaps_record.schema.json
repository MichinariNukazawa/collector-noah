{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atelier.local/schemas/gaps_record.schema.json",
  "title": "GapsRecord",
  "description": "Collector に保存する gaps レコード。POST /api/gaps の入力は #/$defs/submission。",
  "allOf": [{"$ref": "#/$defs/observation"}],
  "required": ["received_at"],
  "properties": {
    "received_at": {"$ref": "#/$defs/utc_timestamp"}
  },
  "unevaluatedProperties": false,
  "$defs": {
    "submission": {
      "allOf": [{"$ref": "#/$defs/observation"}],
      "unevaluatedProperties": false
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$"
    },
    "observation": {
      "type": "object",
      "required": ["schema", "id", "source", "gap_type", "detected_at"],
      "properties": {
        "schema": {"type": "integer", "const": 1},
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "source": {
          "description": "sites.json の対応サイト ID。",
          "enum": ["x", "pixiv", "danbooru", "dmm", "dlsite", "melonbooks"]
        },
        "gap_type": {"enum": ["action_missing", "image_limit_exceeded"]},
        "detected_at": {"$ref": "#/$defs/utc_timestamp"},
        "action": {"enum": ["like", "save", "bookmark", "follow"]},
        "observed_count": {"type": "integer", "minimum": 2, "maximum": 9007199254740991},
        "image_limit": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "if": {
        "properties": {"gap_type": {"const": "action_missing"}}
      },
      "then": {
        "required": ["action"],
        "not": {
          "anyOf": [{"required": ["observed_count"]}, {"required": ["image_limit"]}]
        }
      },
      "else": {
        "required": ["observed_count", "image_limit"],
        "not": {"required": ["action"]}
      }
    }
  }
}
